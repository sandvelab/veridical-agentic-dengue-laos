__pycache__/
*.pyc
.DS_Store
.venv/
.env

# AI-generated/hierarchical-report/ is derived and regenerable, but it is committed rather
# than ignored: a reader on the repository host cannot open a report that is not there.
# Each build stamps its date and commit into index.html and README.md, so a stale copy
# says what it is a snapshot of. (Ignored through batch 33; see its provenance.md.)

# Large intermediates belong in a data store with content-addressed references,
# not in git history. Uncomment and adjust for this project's data:
# analysis/**/results/*.bam
# analysis/**/results/*.h5

# Obsidian vault UI state — not part of the method.
.obsidian/

# Personal working preferences, not method: permission grants specific to one
# machine and one operator, which change nothing about what the analysis does.
.claude/settings.local.json

# The analysis environment itself — rebuilt from environment/lock.txt by
# environment/install-chap.sh. The specification is tracked; the build is not.
environment/chapenv/

# The reconnaissance smoke test's working directory: a fetched example dataset, a cloned
# example model and the ~200 MB virtual environment chap-core builds for it. Rebuilt from
# pinned refs by AI-internal/reconnaissance/capture_chap_surface.sh.
AI-generated/chap-reconnaissance/smoke-work/

# Batch-4 reconnaissance working directories: the pulled 4.7 GB reference image's run
# directories, a clone of the model-library sweep, and per-repeat evaluation files.
# Rebuilt from pinned refs by AI-internal/reconnaissance/run_ewars_reference.sh,
# ewars_reproducibility.sh and capture_model_library.sh.
AI-generated/method-reconnaissance/ewars-work/
AI-generated/method-reconnaissance/library-work/
AI-generated/method-reconnaissance/native-work/

# Batch-6 working directory: chap-core's per-split run directories and the ~200 MB
# environment uv builds for the model. Rebuilt by
# AI-internal/vertical-slice/run_vertical_slice.sh.
AI-generated/vertical-slice/slice-work/
# Node working directories: chap-core's per-split run directories and the ~200 MB
# environment uv builds for each model. Regenerated by the node's own run.sh.
analysis/**/work/

# The working-tree half of the holdout seal (plan §3). Gitignored on purpose: it says
# whether *this* tree opened the held-out year, and a versioned seal would seal every
# clone, which is what stopped analysis/run.sh from reproducing phase E from nothing.
# The versioned half, results/run_status_holdout.csv, stays tracked as the evidence.
analysis/05_stability/.holdout_opened

# The clean-room's scratch clone and its logs. `/validate cleanroom` clones the repository
# into AI-internal/useful-scripts/repo, builds the environment there and runs the whole
# analysis, which is about 22 GB of working directories inside the repository it is
# checking. Batches 18, 25, 27 and 31 each deleted it by hand before committing; ignoring it
# is the same discipline without the step that can be forgotten, and a forgotten one would
# stage twenty gigabytes. The run's findings are copied to
# AI-generated/validation/<date>_cleanroom-artefacts/, which is tracked.
AI-internal/useful-scripts/repo/
AI-internal/useful-scripts/cleanroom_console.log
AI-internal/useful-scripts/cleanroom_head.txt
AI-internal/useful-scripts/run.log
AI-internal/useful-scripts/install_env.log
AI-internal/useful-scripts/run_exit_status.txt
AI-internal/useful-scripts/run_seconds.txt
AI-internal/useful-scripts/diff_status.txt
AI-internal/useful-scripts/diff_stat.txt
